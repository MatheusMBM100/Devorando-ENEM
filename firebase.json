{
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "img/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
    ]
  }
}
