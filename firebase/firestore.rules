rules_version = '2';
// Devorando ENEM: regras de segurança do Firestore.
// Cole este conteúdo em Firestore Database → Regras e clique em Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function ehAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // conta desativada pelo administrador não grava dados
    function ativa() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('desativado', false);
    }

    // Perfil: a pessoa lê e grava o próprio (nome e e-mail); o administrador lê, altera e apaga todos.
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nome', 'telefone', 'createdAt']);
      allow update: if logado() && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'nome', 'telefone']))
        || ehAdmin());
      allow delete: if ehAdmin();
    }

    // Resumo de desempenho: a pessoa grava o próprio; ela e o administrador leem.
    match /userStats/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create, update: if logado() && request.auth.uid == uid && ativa();
      allow delete: if ehAdmin();
    }

    // Dados completos (respostas, simulados): a pessoa lê e grava os próprios; o administrador lê e apaga.
    match /userData/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create, update: if logado() && request.auth.uid == uid && ativa();
      allow delete: if ehAdmin();
    }

    // Administradores: cada um vê o próprio registro; só administradores listam e alteram.
    match /admins/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      allow create: if ehAdmin();
      allow delete: if ehAdmin() && request.auth.uid != uid;
      allow update: if false;
    }

    // Turmas: o administrador gerencia; o aluno lê as turmas em que está.
    match /turmas/{turma} {
      allow read: if logado() && (ehAdmin() || request.auth.uid in resource.data.alunos);
      allow write: if ehAdmin();

      match /simulados/{sim} {
        allow read: if logado() && (ehAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/turmas/$(turma)).data.alunos);
        allow write: if ehAdmin();
      }

      // Ranking: todo aluno da turma grava o próprio registro (só o administrador lê sempre).
      // O aluno só lê o ranking se o administrador marcar verRanking = true no perfil dele (users/{uid}).
      match /ranking/{uid} {
        allow read: if logado() && (ehAdmin()
          || (request.auth.uid in get(/databases/$(database)/documents/turmas/$(turma)).data.alunos
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verRanking', false) == true));
        allow create, update: if logado() && request.auth.uid == uid && ativa()
          && request.auth.uid in get(/databases/$(database)/documents/turmas/$(turma)).data.alunos
          && request.resource.data.keys().hasOnly(['apelido', 'semana', 'semIni', 'respondidas', 'acertos', 'atualizado'])
          && request.resource.data.apelido is string && request.resource.data.apelido.size() <= 20;
        allow delete: if ehAdmin();
      }

      // Resultados: o aluno grava e lê o próprio; o administrador lê e apaga todos.
      match /resultados/{res} {
        allow read: if logado() && (ehAdmin() || resource.data.uid == request.auth.uid);
        allow create, update: if logado() && request.resource.data.uid == request.auth.uid
          && res.matches('.*_' + request.auth.uid) && ativa()
          && request.auth.uid in get(/databases/$(database)/documents/turmas/$(turma)).data.alunos;
        allow delete: if ehAdmin();
      }
    }

    // Reportes de erro: qualquer pessoa logada cria o seu; só o administrador lê e gerencia.
    match /reports/{id} {
      allow create: if logado() && request.resource.data.uid == request.auth.uid
        && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 2000;
      allow read, update, delete: if ehAdmin();
    }

    // Redações: o aluno envia e lê as próprias; só o administrador corrige (update).
    match /redacoes/{id} {
      allow create: if logado() && ativa() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'tema', 'texto', 'criada', 'status', 'tipo', 'fotos'])
        && (!('fotos' in request.resource.data) || (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 2))
        && request.resource.data.status == 'enviada'
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 8000
        && request.resource.data.tema is string && request.resource.data.tema.size() <= 300;
      allow read: if logado() && (resource.data.uid == request.auth.uid || ehAdmin());
      allow update: if ehAdmin();
      allow delete: if ehAdmin() || (logado() && resource.data.uid == request.auth.uid && resource.data.status == 'enviada');

      // Foto da redação corrigida e comentada pelo professor: o aluno só lê depois de corrigida.
      match /anotadas/{foto} {
        allow read: if logado() && (ehAdmin()
          || (get(/databases/$(database)/documents/redacoes/$(id)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/redacoes/$(id)).data.status == 'corrigida'));
        allow write: if ehAdmin();
      }
    }

    // Modelos de comentário da correção de redações: só administradores.
    match /modelos/{id} {
      allow read, write: if ehAdmin();
    }

    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
